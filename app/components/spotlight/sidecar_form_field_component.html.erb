<%= tag.div class: wrapper_class do %>
  <% value_list.each_with_index do |v, index| %>
    <%= form.label field_id, label, namespace: "f#{index}", class: label_class(hidden: index.positive?) %>
    <%= tag.div class: value_wrapper_class(first: index.zero?) do %>
      <%= render_input(value: v, namespace: "f#{index}") %>
    <% end %>
  <% end %>

  <% if multiple && !readonly %>
    <%= content_tag :template, id: template_id do %>
      <%= form.label field_id, label, class: label_class(hidden: true) %>
      <%= tag.div class: value_wrapper_class(first: false) do %>
        <%= render_input %>
      <% end %>
    <% end %>
    <%= content_tag :button, t('helpers.action.add_another'), class: 'btn btn-info btn-sm col-auto h-100', data: { action: 'add-another', template_id: template_id } %>
  <% end %>
<% end %>
