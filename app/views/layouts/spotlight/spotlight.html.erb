<% content_for(:content) do %>
  <% if content? :sidebar %>
    <% sidebar_tag = content_for(:sidebar_type) == 'nav' ? 'nav' : 'aside' %>
    <% sidebar_label = content_for(:sidebar_label) ? content_for(:sidebar_label) : t('blacklight.search.documents.aria.limit_search') %>
   
    <<%= sidebar_tag %> id="sidebar" class="<%= sidebar_classes %> <%= content_for(:sidebar_position) %>" aria-label="<%= sidebar_label %>">
      <%= content_for(:sidebar) %>
    </<%= sidebar_tag %>>

    <% content_aria_label = t('blacklight.search.search_results') unless content_for?(:no_content_label) %>
    <section id="content" class="<%= main_content_classes %> <%= content_for(:content_position) %>" <% if content_aria_label %>aria-label="<%= content_aria_label %>"<% end %>>
      <%= yield %>
    </section>
  <% else %>
    <section id="content" class="col-md-12">
      <%= yield %>
    </section>
  <% end %>
<% end %>

<%= render template: "layouts/spotlight/base" %>
