<%
  unpublished_exhibits = @exhibits.unpublished.ordered_by_weight.accessible_by(current_ability)
  show_unpublished_tab = can?(:manage, Spotlight::Exhibit) && unpublished_exhibits.any?
  show_user_tab = current_user && current_user.exhibits.any?
  matching_unpublished_exhibits = exhibit_search.filter(unpublished_exhibits)
  matching_user_exhibits = exhibit_search.filter(current_user.exhibits) if show_user_tab
  show_tabs = show_user_tab || can?(:manage, Spotlight::Exhibit)
  published_status = exhibit_search_status(@published_exhibits.total_count, tab: (:published if show_tabs))
%>

<% if @exhibits.published.any? || unpublished_exhibits.any? || show_user_tab %>
  <% content_for(:header_content) do %>
    <%= render 'search', status: published_status %>
  <% end %>
<% end %>

<% if show_tabs %>
  <ul class="nav nav-tabs" role="tablist">
    <li role="presentation" class="nav-item"><a href="#published" aria-controls="published" role="tab" data-bs-toggle="tab" class="nav-link active"><%= t('.published') %></a></li>
    <% if show_unpublished_tab %>
      <li role="presentation" class="nav-item"><a href="#unpublished" aria-controls="unpublished" role="tab" data-bs-toggle="tab" class="nav-link"><%= t('.unpublished') %></a></li>
    <% end %>
    <% if show_user_tab %>
      <li role="presentation" class="nav-item"><a href="#user" aria-controls="user" role="tab" data-bs-toggle="tab" class="nav-link"><%= t('.user') %></a></li>
    <% end %>
  </ul>
<% end %>

<div class="tab-content" id="exhibit-search-results">
  <div role="tabpanel" class="tab-pane active" id="published" data-exhibit-search-swap data-exhibit-search-status="<%= published_status %>">
    <% if @exhibits.published.none? %>
      <%= render 'missing_exhibits' %>
    <% else %>
      <%= render 'tags', tags: @exhibits.published.all_tags, matching_tag_names: exhibit_search_matching_tag_names(@exhibits.published) %>

      <% if @published_exhibits.none? && exhibit_search.active? %>
        <%= render 'no_matches' %>
      <% else %>
        <%= render 'exhibits', exhibits: @published_exhibits %>
      <% end %>

      <% if @published_exhibits.total_count > @published_exhibits.size %>
        <nav class="d-flex justify-content-center">
          <ul class="pagination">
            <li class="page-item"><%= link_to_previous_page @published_exhibits, t('views.pagination.previous').html_safe, class: 'page-link' %></li>
            <li class="page-item"><%= link_to_next_page @published_exhibits, t('views.pagination.next').html_safe, class: 'page-link' %></li>
          </ul>
        </nav>
      <% end %>
    <% end %>

  </div>

  <% if unpublished_exhibits.any? %>
    <div role="tabpanel" class="tab-pane" id="unpublished" data-exhibit-search-swap data-exhibit-search-status="<%= exhibit_search_status(matching_unpublished_exhibits.size, tab: :unpublished) %>">
      <% if matching_unpublished_exhibits.none? %>
        <%= render 'no_matches' %>
      <% else %>
        <%= render 'exhibits', exhibits: matching_unpublished_exhibits %>
      <% end %>
    </div>
  <% end %>

  <% if show_user_tab %>
    <div role="tabpanel" class="tab-pane" id="user" data-exhibit-search-swap data-exhibit-search-status="<%= exhibit_search_status(matching_user_exhibits.size, tab: :user) %>">
      <% if matching_user_exhibits.none? %>
        <%= render 'no_matches' %>
      <% else %>
        <%= render 'exhibits', exhibits: matching_user_exhibits %>
      <% end %>
    </div>
  <% end %>
</div>

<% content_for(:sidebar_position) { 'order-last' } %>
<% content_for(:sidebar) do %>
  <%= render "shared/site_sidebar" %>
<% end %>
