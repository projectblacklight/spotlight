<%= bootstrap_form_for @exhibit, url: ((spotlight.exhibit_path(@exhibit) if @exhibit.persisted?) || spotlight.exhibits_path), layout: :horizontal, label_col: 'col-md-2', control_col: 'col-md-10', html: {class: "row"} do |f| %>
<div class="col-md-12">
  <%= f.text_field :title, disabled: !default_language?, help: !default_language? ? t('.uneditable_non_default_language') : '' %>
  <%= f.text_field :subtitle, disabled: !default_language?, help: !default_language? ? t('.uneditable_non_default_language') : '' %>
  <%= f.text_area :description, disabled: !default_language?, help: !default_language? ? t('.uneditable_non_default_language') : '' %>
  <%= render Spotlight::TagListFormComponent.new(form: f) %>
  <%= f.form_group(:contact_emails, label: { text: nil, class: nil, for: 'exhibit_contact_email_0' }, class: 'form-group mb-3', help: nil) do %>
    <%= f.fields_for :contact_emails do |contact| %>
      <%= render partial: 'contact', locals: {exhibit: @exhibit, contact: contact} %>
    <% end %>
    <button id="another-email" class="btn btn-sm btn-info"><%= t('.add_contact_email_button') %></button>
    <div class="form-text text-muted mb-3"><%= t(:'.fields.contact_emails.help_block') %></div>
  <% end %>
  <div class="row mb-3">
    <div class="col-md-2 col-form-label pt-0"><%= t(:'.fields.publishing.status_label') %></div>
    <div class="col-md-10" data-controller="clipboard">
      <span class="badge <%= { published: 'text-bg-success', published_unlisted: 'text-bg-warning', unpublished: 'text-bg-secondary' }[@exhibit.publishing_status] %>">
        <%= t(:".fields.publishing.status.#{@exhibit.publishing_status}") %>
      </span>
      <code class="text-break ms-2 text-muted" data-clipboard-target="text"><%= spotlight.exhibit_url(@exhibit) %></code>
      <button type="button" class="btn btn-sm btn-outline-secondary py-0 ms-1" data-action="click->clipboard#copy"><%= t(:'.fields.publishing.copy_url') %></button>
    </div>
  </div>
  <fieldset class="row mb-3">
    <legend class="col-md-2 col-form-label pt-0"><%= Spotlight::Exhibit.human_attribute_name(:published) %></legend>
    <div class="col-md-10">
      <div class="form-check">
        <%= f.check_box_without_bootstrap :published, class: 'form-check-input', aria: { describedby: 'exhibit_published_help' } %>
        <%= f.label :published, t(:'.fields.published.label'), class: 'form-check-label' %>
        <div id="exhibit_published_help" class="form-text text-muted"><%= t(:'.fields.published.help_block') %></div>
      </div>
    </div>
  </fieldset>
  <fieldset class="row mb-3">
    <legend class="col-md-2 col-form-label pt-0"><%= t(:'.fields.listed.legend') %></legend>
    <div class="col-md-10">
      <div class="form-check">
        <%= f.check_box_without_bootstrap :listed, class: 'form-check-input', disabled: !@exhibit.published?, aria: { describedby: 'exhibit_listed_help' } %>
        <%= f.label :listed, t(:'.fields.listed.label'), class: 'form-check-label' %>
        <div id="exhibit_listed_help" class="form-text text-muted"><%= t(:'.fields.listed.help_block') %></div>
      </div>
    </div>
  </fieldset>

  <div class="form-actions">

    <div class="primary-actions">
      <%= f.submit nil, class: 'btn btn-primary' %>
    </div>
  </div>
</div>
<% end %>
